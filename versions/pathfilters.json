            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@clr-only" ]
        },
        "nanoBooter/ThreadX-ST": {
            "include": [ "@repo-build", "@kconfig-booter", "@src-booter", "/targets/ThreadX", "/targets/ThreadX/ST", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-ST" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@clr-only" ]
        }
