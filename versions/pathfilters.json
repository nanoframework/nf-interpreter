            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors" ]
        },
        "firmware/ThreadX-Nordic": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/Nordic", "@cmake-arm", "@cmake-ThreadX" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors" ]
        },
        "firmware/ThreadX-RaspberryPi": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/RaspberryPi", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-RaspberryPi" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors" ]
        },
        "firmware/ThreadX-SiliconLabs": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/SiliconLabs", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-SiliconLabs" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors" ]
        },
        "firmware/ThreadX-ST": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/ST", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-ST" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors" ]
        },
        "nanoCLR/ChibiOS": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ChibiOS", "/targets-community", "@cmake-arm", "@cmake-ChibiOS", "@from-ThreadX-for-ChibiOS", "@from-MCUboot-for-nanoCLR", "@cmake-MCUboot" ],
            "exclude": [ "@cmake-platforms", "@booter-only", "@mcuboot-only" ]
        },
        "nanoCLR/ESP32": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ESP32", "@cmake-ESP32" ],
            "exclude": [ "@cmake-platforms", "@booter-only" ]
        },
        "nanoCLR/FreeRTOS-NXP": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/FreeRTOS", "@cmake-arm", "@cmake-FreeRTOS" ],
            "exclude": [ "@cmake-platforms", "@booter-only" ]
        },
        "nanoCLR/TI_SimpleLink": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/TI_SimpleLink", "/targets-community", "@cmake-arm", "@cmake-TI_SimpleLink" ],
            "exclude": [ "@cmake-platforms", "@booter-only" ]
        },
        "nanoCLR/ThreadX-Maxim": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/Maxim", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-Maxim" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@booter-only" ]
        },
        "nanoCLR/ThreadX-MicroBit": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/MicroBit", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-MicroBit" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@booter-only" ]
        },
        "nanoCLR/ThreadX-Nordic": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/Nordic", "@cmake-arm", "@cmake-ThreadX" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@booter-only" ]
        },
        "nanoCLR/ThreadX-RaspberryPi": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/RaspberryPi", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-RaspberryPi" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@booter-only" ]
        },
        "nanoCLR/ThreadX-SiliconLabs": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/SiliconLabs", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-SiliconLabs" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@booter-only" ]
        },
        "nanoCLR/ThreadX-ST": {
            "include": [ "@repo-build", "@kconfig-all", "@src-clr", "/targets/ThreadX", "/targets/ThreadX/ST", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-ST" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@booter-only" ]
        },
        "nanoMCUboot/ChibiOS": {
            "include": [ "@repo-build", "@kconfig-mcuboot", "/MCUboot", "/targets/ChibiOS", "/targets/ChibiOS/_common/targetHAL_Watchdog.c", "@cmake-arm", "@cmake-ChibiOS", "@cmake-MCUboot" ],
            "exclude": [ "@cmake-platforms", "@booter-only", "@clr-only", "/targets/ChibiOS/_common" ]
        },
        "nanoBooter/ChibiOS": {
            "include": [ "@repo-build", "@kconfig-booter", "@src-booter", "/targets/ChibiOS", "/targets-community", "@cmake-arm", "@cmake-ChibiOS", "@from-ThreadX-for-ChibiOS" ],
            "exclude": [ "@cmake-platforms", "@clr-only", "@mcuboot-only" ]
        },
        "nanoBooter/FreeRTOS-NXP": {
            "include": [ "@repo-build", "@kconfig-booter", "@src-booter", "/targets/FreeRTOS", "@cmake-arm", "@cmake-FreeRTOS" ],
            "exclude": [ "@cmake-platforms", "@clr-only" ]
        },
        "nanoBooter/ThreadX-Maxim": {
            "include": [ "@repo-build", "@kconfig-booter", "@src-booter", "/targets/ThreadX", "/targets/ThreadX/Maxim", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-Maxim" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@clr-only" ]
        },
        "nanoBooter/ThreadX-MicroBit": {
            "include": [ "@repo-build", "@kconfig-booter", "@src-booter", "/targets/ThreadX", "/targets/ThreadX/MicroBit", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-MicroBit" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@clr-only" ]
