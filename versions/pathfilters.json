        "nanoBooter/ThreadX-RaspberryPi": {
            "include": [ "@repo-build", "@kconfig-booter", "@src-booter", "/targets/ThreadX", "/targets/ThreadX/RaspberryPi", "@cmake-arm", "@cmake-ThreadX", "@cmake-ThreadX-RaspberryPi" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@clr-only" ]
        },
        "nanoBooter/ThreadX-SiliconLabs": {
