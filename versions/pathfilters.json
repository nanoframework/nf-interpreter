        "nanoBooter/ThreadX-Nordic": {
            "include": [ "@repo-build", "@kconfig-booter", "@src-booter", "/targets/ThreadX", "/targets/ThreadX/Nordic", "@cmake-arm", "@cmake-ThreadX" ],
            "exclude": [ "@cmake-platforms", "@targets-ThreadX-vendors", "@clr-only" ]
